# 복사해서 .env.local 로 사용하세요 (.env.local 은 Git에 올라가지 않습니다).
# 로컬: `npm run supabase:status` 출력의 API URL / Publishable key
# 원격: Supabase 대시보드 → Project Settings → API
#
# ⚠️ 여기에는 공개용 값만 넣습니다. service_role / secret key 는 절대 넣지 마세요.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
